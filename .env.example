# Firebase web-app config. Copy this file to `.env`, fill in your values, then run:
#
#   node scripts/generate-config.mjs
#
# That writes js/config.js, which the browser imports. Re-run it whenever you edit .env.
#
# Where to find the values: Firebase Console -> Project settings (gear icon) ->
# General -> Your apps -> Web app -> "SDK setup and configuration" -> Config.
#
# Note: Firebase web config identifies your project, it does not grant access to it.
# Your Firestore security rules (see README) are what actually protect the data.
#
# Only put Firebase WEB config in this file. The dev server serves the whole project
# folder and the browser downloads js/config.js, so never store server-side secrets
# here (service-account keys, Admin SDK credentials, etc.).

FIREBASE_API_KEY=REPLACE_ME
FIREBASE_AUTH_DOMAIN=REPLACE_ME
FIREBASE_PROJECT_ID=REPLACE_ME
FIREBASE_STORAGE_BUCKET=REPLACE_ME
FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
FIREBASE_APP_ID=REPLACE_ME

# Optional. The Firebase console snippet includes databaseURL when the project has a
# Realtime Database. This app uses Firestore, so it is not needed and can stay empty.
FIREBASE_DATABASE_URL=

# Optional (only present if Google Analytics is enabled for the project)
FIREBASE_MEASUREMENT_ID=
